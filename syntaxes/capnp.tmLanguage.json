{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Cap'n Proto",
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#definition"
		},
		{
			"include": "#keyword"
		},
		{
			"include": "#separator"
		},
		{
			"include": "#literal"
		},
		{
			"include": "#id"
		},
		{
			"include": "#operator"
		},
		{
			"include": "#typeref"
		}
	],
	"repository": {
		"id": {
			"patterns": [
				{
					"name": "constant.numeric.hex.capnp",
					"match": "@0x[0-9A-Fa-f]+"
				},
				{
					"name": "constant.numeric.dec.capnp",
					"match": "@\\d+"
				}
			]
		},
		"comment": {
			"patterns": [
				{
					"name": "comment.line.capnp",
					"match": "#.+"
				}
			]
		},
		"name": {
			"patterns": [{
				"name": "entity.name.capnp",
				"match": "[A-Za-z]\\w*"
			},{
				"name": "entity.name.capnp",
				"begin": "[A-Za-z]\\w*\\(",
				"end": "\\)",
				"match": "#name"
			}]
		},
		"keyword": {
			"patterns": [{
				"name": "storage.type.capnp",
				"match": "const"
			},{
				"name": "storage.type.interface.capnp",
				"match": "interface"
			}, {
				"name": "storage.type.enum.capnp",
				"match": "enum"
			}, {
				"name": "storage.type.type.capnp",
				"match": "using"
			}, {
				"name": "storage.type.class.capnp",
				"match": "struct"
			}, {
				"name": "keyword.other.annotation.capnp",
				"match": "annotation"
			}, {
				"name": "keyword.other.file.capnp",
				"match": "file"
			}]
		},
		"import": {
			"patterns": [
				{
					"name": "meta.import.capnp",
					"match": "(using)(?:\\s+(\\w+))?(?:\\s*=)?(?:\\s*(import))",
					"captures": {
						"1": {
							"name": "keyword.control.using.capnp"
						},
						"2": {
							"name": "variable.name.capnp"
						},
						"3": {
							"name": "keyword.control.import.capnp"
						}
					}
				}
			]
		},
		"typeref": {
			"patterns": [
				{
					"name": "meta.typeref.capnp",
					"match": "(:)([\\w\\(\\), ]*)",
					"captures": { 
						"1": {
							"name": "keyword.operator.type.capnp"
						},
						"2": {
							"name": "entity.name.class.capnp",
							"patterns":[
								{ "include": "#name"}
							]
						} 
					}
				}
			]
		},
		"assignment": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.capnp",
					"match": "="
				}
			]
		},
		"operator": {
			"patterns": [
				{"include": "#assignment"}
			]
		},
		"separator": {
			"patterns": [{
				"name": "punctuation.separator.comma.capnp",
				"match": ","
			}, {
				"name": "punctuation.terminator.statement.capnp",
				"match": ";"
			}]
		},
		"definition": {
			"patterns": [
				{"include": "#import"},
				{"include": "#struct"},
				{"include": "#enum"},
				{"include": "#constant"},
				{"include": "#annotation"},
				{"include": "#interface"}
			]
		},
		"constant": {
			"patterns": [{
				"name": "meta.var.expr.capnp",
				"begin": "(const)\\s+(\\w+)\\s*(:\\w+)\\s*=\\s*",
				"end": "(;)",
				"patterns": [
					{
						"include": "#literal"
					},
					{
						"begin": "\\(",
						"end": "\\)",
						"patterns": [
							{"include": "#separator"},
							{"include": "#assignment"},
							{"include": "#valueRef"},
							{
								"name": "variable.object.property.capnp",
								"match": "[A-Za-z]\\w*"
							}
						]
					}
				],
				"beginCaptures": {
					"1": {
						"patterns": [{"include": "#keyword"}]
					},
					"2": {
						"name": "variable.other.constant.capnp"
					},
					"3": {
						"patterns": [{"include": "#typeref"}]
					}
				},
				"endCaptures": {
					"1": {
						"patterns": [{"include": "#separator"}]
					}
				}
		}]
		},
		"typedef": {
			"patterns": [
				{
					"include": "#struct"
				},
				{
					"include": "#interface"
				},
				{
					"include": "#enum"
				}
			]
		},
		"annotation": {
			"name": "meta.annotation.capnp",
			"begin": "(annotation)\\s+(\\w+)\\(",
			"patterns": [
				{"include": "#separator"},
				{"include": "#keyword"},
				{
					"name": "keyword.other.wildcard.capnp",
					"match": "\\*"
				}
			],
			"end": "\\)\\s*(:\\w+)(;)",
			"beginCaptures": {
				"1": {"patterns": [{"include": "#keyword"}]},
				"2": {
					"name": "storage.type.capnp",
					"patterns": [{"include": "#name"}]
				}
			},
			"endCaptures": {
				"1": {"patterns": [{"include": "#typeref"}]}
			}
		},
		"enum": {
			"patterns": [
				{
					"name": "meta.struct.capnp",
					"begin": "(enum)(?:\\s+(\\w+))?(?:\\s+(@\\w+))?(\\s*{)?",
					"end": "}",
					"patterns": [
						{
							"include": "#comment"
						},
						{
							"include": "#union"
						},
						{
							"include": "#field"
						}
					],
					"beginCaptures": {
						"1": {
							"name": "storage.type.class.capnp"
						},
						"2": {
							"name": "entity.name.type.struct.capnp"
						},
						"3": {
							"patterns": [
								{
									"include": "#id"
								}
							]
						}
					}
				}
			]
		},
		"struct": {
			"patterns": [
				{
					"name": "meta.struct.capnp",
					"begin": "(struct)(?:\\s+(\\w+))?(?:\\s+(@\\w+))?(\\s*{)?",
					"end": "}",
					"patterns": [
						{
							"include": "#comment"
						},
						{
							"include": "#definition"
						},
						{
							"include": "#union"
						},
						{
							"include": "#field"
						}
					],
					"beginCaptures": {
						"1": {
							"name": "storage.type.class.capnp"
						},
						"2": {
							"name": "entity.name.type.struct.capnp"
						},
						"3": {
							"patterns": [
								{
									"include": "#id"
								}
							]
						}
					}
				}
			]
		},
		"union": {
			"patterns": [
				{
					"name": "meta.union.capnp",
					"begin": "(union)(\\s*{)",
					"patterns": [
						{
							"include": "#field"
						},
						{
							"include": "#comment"
						}
					],
					"end": "}",
					"beginCaptures": {
						"1": {
							"name": "storage.type.enum.capnp"
						}
					}
				}
			]
		},
		"interface": {
			"patterns": [
				{
					"name": "meta.interface.capnp",
					"begin": "(interface)(?:\\s+(\\w+))?(?:\\s+(@\\w+))?\\s*{?",
					"end": "}",
					"patterns": [
						{
							"include": "#comment"
						},
						{
							"include": "#method"
						},
						{
							"include": "#definition"
						}
					],
					"captures": {
						"1": {
							"name": "storage.type.interface.capnp"
						},
						"2": {
							"name": "entity.name.type.interface.capnp"
						},
						"3": {
							"patterns": [
								{
									"include": "#id"
								}
							]
						}
					}
				}
			]
		},
		"field": {
			"patterns": [
				{
					"name": "meta.field.capnp",
					"match": "(\\w+)(?:\\s*(@\\w+))?(?:\\s*(:[\\w(),\\s]*))?",
					"captures": {
						"1": {
							"name": "variable.object.property.capnp"
						},
						"2": {
							"patterns": [
								{
									"include": "#id"
								}
							]
						},
						"3": {
							"patterns": [
								{
									"include": "#typeref"
								}
							]
						}
					}
				}
			]
		},
		"method": {
			"patterns": [
				{
					"name": "meta.method.capnp",
					"match": "(\\w+)(?:\\s*(@\\w*))(?:\\s*(?:(\\([^)]*\\))|(\\w+)))?(?:\\s*->)?(?:\\s*(?:(\\([^)]*\\))|(\\w+)))",
					"captures": {
						"1": {
							"name": "entity.name.function.member.capnp"
						},
						"2": {
							"patterns": [
								{
									"include": "#id"
								}
							]
						},
						"3": {
							"patterns": [
								{
									"include": "#methodArgs"
								}
							]
						},
						"4": {
							"name": "entity.name.type.capnp",
							"patterns": [
								{
									"include": "#name"
								}
							]
						},
						"5": {
							"patterns": [
								{
									"include": "#methodArgs"
								}
							]
						},
						"6": {
							"name": "entity.name.type.capnp",
							"patterns": [
								{
									"include": "#name"
								}
							]
						}
					}
				}
			]
		},
		"methodArgs": {
			"patterns": [
				{
					"name": "meta.method.args.capnp",
					"begin": "\\(",
					"end": "\\)",
					"patterns": [
						{
							"name": "variable.parameter.capnp",
							"match": "(\\w+)(?:\\s*(:[^)]*\\)))?",
							"captures": {
								"1": {
									"name": "variable.parameter.capnp"
								},
								"2": {
									"name": "meta.argvar",
									"patterns": [
										{
											"include": "#typeref"
										}
									]
								}
							}
						}
					]
				}
			]
		},
		"valueRef": {
			"name": "meta.valueRef.capnp",
			"patterns": [
				{"include": "#literal"},
				{
					"name": "variable.other.ref.capnp",
					"match": "\\.[A-Za-z]\\w*"
				}
			]
		},
		"literal": {
			"name": "meta.literal.capnp",
			"patterns": [
				{"include": "#string"},
				{"include": "#boolean"},
				{"include": "#numeric"}
			]
		},
		"boolean": {
			"name": "constant.language.boolean.capnp",
			"match": "(false|true)"
		},
		"numeric": {
			"name": "constant.numeric.capnp",
			"match": "(0x[0-9A-Fa-f]+)|(\\d+)"
		},
		"string": {
			"name": "string.quoted.double.capnp",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.capnp",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.capnp"
}
